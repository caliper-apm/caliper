{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliper-apm.dev/spec/v0.1/envelope.schema.json",
  "title": "Caliper APM Ingestion Batch Envelope (v0.1)",
  "description": "OTLP-aligned, Native-First mobile telemetry batch payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sent_at_ms", "resource", "events"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sent_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "platform",
        "env",
        "app_version",
        "build_number",
        "sdk_name",
        "sdk_version",
        "install_hash"
      ],
      "properties": {
        "app_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "enum": ["android", "ios"] },
        "env": { "type": "string", "enum": ["prod", "staging", "dev"] },
        "app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "build_number": { "type": "string", "minLength": 1, "maxLength": 64 },
        "git_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,40}$" },
        "symbol_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter": { "type": "string", "enum": ["native", "react-native"] },
        "sdk_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sdk_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "install_hash": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "user_hash": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "os_version": { "type": "string", "maxLength": 32 },
        "device_model": { "type": "string", "maxLength": 64 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "kind",
          "occurred_at_ms",
          "contract_version",
          "payload"
        ],
        "properties": {
          "event_id": { "type": "string", "minLength": 8, "maxLength": 64 },
          "kind": {
            "type": "string",
            "enum": [
              "startup",
              "crash",
              "anr",
              "abnormal_exit",
              "fluency_window",
              "resource_window",
              "js_longtask_window",
              "network_summary",
              "network_transport",
              "custom_scene",
              "cpu_profile",
              "heap_snapshot"
            ]
          },
          "occurred_at_ms": { "type": "integer", "minimum": 0 },
          "contract_version": { "type": "integer", "minimum": 1 },
          "scene": { "type": "string", "maxLength": 64 },
          "window_id": { "type": "string", "maxLength": 64 },
          "policy_id": { "type": "string", "maxLength": 64 },
          "sample_rate_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
