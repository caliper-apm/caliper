{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliper-apm.dev/spec/v0.1/events.schema.json",
  "title": "Caliper APM Event Payloads (v0.1)",
  "description": "Strict payload contracts per event kind under envelope.schema.json.",
  "$defs": {
    "startup": {
      "type": "object",
      "required": ["total_duration_ms", "cold_start", "start_anchor", "end_anchor", "result"],
      "properties": {
        "total_duration_ms": { "type": "number", "minimum": 0, "maximum": 600000 },
        "native_init_ms": { "type": "number", "minimum": 0 },
        "runtime_init_ms": { "type": "number", "minimum": 0 },
        "first_frame_ms": { "type": "number", "minimum": 0 },
        "cold_start": { "type": "boolean" },
        "start_anchor": { "type": "string", "minLength": 1, "maxLength": 64 },
        "end_anchor": { "type": "string", "minLength": 1, "maxLength": 64 },
        "result": { "type": "string", "enum": ["success", "aborted", "timeout"] }
      }
    },
    "stability_issue": {
      "type": "object",
      "required": ["fingerprint", "title", "fatal", "frames"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 4, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "fatal": { "type": "boolean" },
        "exception_type": { "type": "string", "maxLength": 128 },
        "thread_name": { "type": "string", "maxLength": 64 },
        "exit_reason": { "type": "string", "maxLength": 64 },
        "process_importance": { "type": "string", "maxLength": 64 },
        "frames": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["symbol"],
            "properties": {
              "module": { "type": "string", "maxLength": 128 },
              "symbol": { "type": "string", "maxLength": 256 },
              "file": { "type": "string", "maxLength": 256 },
              "line": { "type": "integer", "minimum": 0 },
              "address": { "type": "string", "maxLength": 32 },
              "in_app": { "type": "boolean" }
            }
          }
        },
        "breadcrumbs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["timestamp_ms", "category", "message"],
            "properties": {
              "timestamp_ms": { "type": "integer", "minimum": 0 },
              "category": { "type": "string", "maxLength": 32 },
              "message": { "type": "string", "maxLength": 256 }
            }
          }
        }
      }
    },
    "fluency_window": {
      "type": "object",
      "required": ["algorithm", "window_duration_ms", "frame_count", "jank_frame_count"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["android_frame_metrics_deadline", "android_frame_metrics_heuristic", "ios_display_link"]
        },
        "window_duration_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "frame_count": { "type": "integer", "minimum": 0 },
        "jank_frame_count": { "type": "integer", "minimum": 0 },
        "severe_jank_frame_count": { "type": "integer", "minimum": 0 },
        "refresh_rate_hz": { "type": "number", "minimum": 1, "maximum": 240 },
        "frame_duration_buckets": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": { "type": "integer", "minimum": 0 }
        },
        "stall_stack": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "resource_window": {
      "type": "object",
      "required": ["window_duration_ms", "cpu_pct", "memory_kind", "memory_peak_kib", "sample_count"],
      "properties": {
        "window_duration_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "cpu_pct": { "type": "number", "minimum": 0, "maximum": 1600 },
        "memory_kind": {
          "type": "string",
          "enum": ["android_pss_kib", "android_rss_kib", "ios_phys_footprint_kib"]
        },
        "memory_peak_kib": { "type": "number", "minimum": 0 },
        "memory_avg_kib": { "type": "number", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 1 }
      }
    },
    "js_longtask_window": {
      "type": "object",
      "required": ["window_duration_ms", "longtask_count", "total_blocking_ms", "max_task_ms"],
      "properties": {
        "window_duration_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "longtask_count": { "type": "integer", "minimum": 0 },
        "total_blocking_ms": { "type": "number", "minimum": 0 },
        "max_task_ms": { "type": "number", "minimum": 0 },
        "dropped_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "network_summary": {
      "type": "object",
      "required": ["window_duration_ms", "call_count", "failure_counts", "duration_buckets", "duration_sum_ms"],
      "properties": {
        "window_duration_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "call_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "failure_counts": {
          "type": "object",
          "properties": {
            "http": { "type": "integer", "minimum": 0 },
            "business": { "type": "integer", "minimum": 0 },
            "parse": { "type": "integer", "minimum": 0 },
            "network": { "type": "integer", "minimum": 0 },
            "timeout": { "type": "integer", "minimum": 0 }
          }
        },
        "duration_buckets": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": { "type": "integer", "minimum": 0 }
        },
        "duration_sum_ms": { "type": "number", "minimum": 0 }
      }
    },
    "network_transport": {
      "type": "object",
      "required": ["operation", "method", "result", "total_ms"],
      "properties": {
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "status_code": { "type": "integer", "minimum": 0, "maximum": 599 },
        "result": { "type": "string", "enum": ["success", "failed", "timeout", "cancelled"] },
        "dns_ms": { "type": "number", "minimum": 0 },
        "tcp_ms": { "type": "number", "minimum": 0 },
        "tls_ms": { "type": "number", "minimum": 0 },
        "ttfb_ms": { "type": "number", "minimum": 0 },
        "body_ms": { "type": "number", "minimum": 0 },
        "total_ms": { "type": "number", "minimum": 0, "maximum": 600000 },
        "connection_reused": { "type": "boolean" },
        "protocol": { "type": "string", "maxLength": 16 },
        "network_type": { "type": "string", "maxLength": 32 },
        "trace_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "span_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
      }
    },
    "custom_scene": {
      "type": "object",
      "required": ["journey_name", "status"],
      "properties": {
        "journey_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["success", "failure", "cancelled", "timeout"] },
        "duration_ms": { "type": "number", "minimum": 0, "maximum": 600000 },
        "error_code": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
